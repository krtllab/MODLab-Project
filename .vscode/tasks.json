{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start static server (port 8080)",
            "type": "shell",
            "command": "python -m http.server 8080 --bind 127.0.0.1",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?!$)"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Serving HTTP"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "group": "debug-server"
            }
        },
        {
            "label": "Stop static server (port 8080)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" | Where-Object { $_.CommandLine -like '*http.server*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"
            ],
            "problemMatcher": []
        }
    ]
}
